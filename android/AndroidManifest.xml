<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.skewershift.game" android:versionCode="1" android:versionName="1.0.0">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:allowBackup="false" android:usesCleartextTraffic="false"
        android:label="Skewer Shift" android:icon="@drawable/skewer_icon" android:theme="@style/SkewerTheme">
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider android:name=".ApkShareProvider" android:authorities="com.skewershift.game.share"
            android:exported="false" android:grantUriPermissions="true" />
    </application>
</manifest>
